{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "g++-14",
            "args": [
                "-DDEBUG",
                "-I/Users/rummanmahmud/Problems/Code-Template/C++",
                "-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "MACOSX_DEPLOYMENT_TARGET": "27.0"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task with g++-14, DEBUG flag, custom headers, and C++23 standard."
        }
    ],
    "version": "2.0.0"
}
